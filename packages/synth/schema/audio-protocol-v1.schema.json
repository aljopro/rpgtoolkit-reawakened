{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tk-reawakened.dev/schema/audio-protocol-v1.schema.json",
  "title": "TK Reawakened runner audio protocol v1",
  "description": "Language-neutral audio messages, events, and voice states. Every record has exactly the keys for its kind; absent values are null.",
  "oneOf": [
    { "$ref": "#/$defs/message" },
    { "$ref": "#/$defs/event" }
  ],
  "$defs": {
    "asset": { "type": "string", "minLength": 1 },
    "track": { "type": "string", "minLength": 1 },
    "voice": { "type": "integer", "minimum": 1 },
    "nullableVoice": { "oneOf": [{ "$ref": "#/$defs/voice" }, { "type": "null" }] },
    "ticks": { "type": "integer", "minimum": 0 },
    "nullableTicks": { "oneOf": [{ "$ref": "#/$defs/ticks" }, { "type": "null" }] },
    "volume": { "type": "integer", "minimum": 0, "maximum": 100 },
    "bank": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source", "id", "sha256"],
      "properties": {
        "source": { "enum": ["bundled", "game", "cdn", "user"] },
        "id": { "type": "string", "minLength": 1 },
        "sha256": { "oneOf": [{ "type": "string", "pattern": "^[0-9a-f]{64}$" }, { "type": "null" }] }
      }
    },
    "nullableBank": { "oneOf": [{ "$ref": "#/$defs/bank" }, { "type": "null" }] },
    "bytes": { "type": "string", "contentEncoding": "base64", "pattern": "^(?:[A-Za-z0-9+/]{4})*(?:[A-Za-z0-9+/]{2}==|[A-Za-z0-9+/]{3}=)?$" },
    "errorCode": {
      "enum": ["format.unsupported", "format.malformed", "bank.missing", "bank.invalid", "bank.unavailable", "source.failed", "output.unavailable", "protocol.state"]
    },
    "message": {
      "oneOf": [
        { "$ref": "#/$defs/load" },
        { "$ref": "#/$defs/play" },
        { "$ref": "#/$defs/pause" },
        { "$ref": "#/$defs/resume" },
        { "$ref": "#/$defs/stop" },
        { "$ref": "#/$defs/seek" },
        { "$ref": "#/$defs/setLoop" },
        { "$ref": "#/$defs/setVolume" },
        { "$ref": "#/$defs/fade" },
        { "$ref": "#/$defs/setBank" }
      ]
    },
    "load": {
      "type": "object", "additionalProperties": false,
      "required": ["kind", "voice", "track", "asset", "data"],
      "properties": { "kind": { "const": "load" }, "voice": { "$ref": "#/$defs/voice" }, "track": { "$ref": "#/$defs/track" }, "asset": { "$ref": "#/$defs/asset" }, "data": { "$ref": "#/$defs/bytes" } }
    },
    "play": {
      "type": "object", "additionalProperties": false,
      "required": ["kind", "voice", "cue", "loop", "volume", "positionTicks"],
      "properties": { "kind": { "const": "play" }, "voice": { "$ref": "#/$defs/voice" }, "cue": { "$ref": "#/$defs/voice" }, "loop": { "type": "boolean" }, "volume": { "$ref": "#/$defs/volume" }, "positionTicks": { "$ref": "#/$defs/ticks" } }
    },
    "pause": {
      "type": "object", "additionalProperties": false,
      "required": ["kind", "voice"],
      "properties": { "kind": { "const": "pause" }, "voice": { "$ref": "#/$defs/voice" } }
    },
    "resume": {
      "type": "object", "additionalProperties": false,
      "required": ["kind", "voice"],
      "properties": { "kind": { "const": "resume" }, "voice": { "$ref": "#/$defs/voice" } }
    },
    "stop": {
      "type": "object", "additionalProperties": false,
      "required": ["kind", "voice"],
      "properties": { "kind": { "const": "stop" }, "voice": { "$ref": "#/$defs/voice" } }
    },
    "seek": {
      "type": "object", "additionalProperties": false,
      "required": ["kind", "voice", "positionTicks"],
      "properties": { "kind": { "const": "seek" }, "voice": { "$ref": "#/$defs/voice" }, "positionTicks": { "$ref": "#/$defs/ticks" } }
    },
    "setLoop": {
      "type": "object", "additionalProperties": false,
      "required": ["kind", "voice", "loop"],
      "properties": { "kind": { "const": "setLoop" }, "voice": { "$ref": "#/$defs/voice" }, "loop": { "type": "boolean" } }
    },
    "scopeFields": {
      "properties": { "scope": { "enum": ["voice", "bus", "master"] }, "voice": { "$ref": "#/$defs/nullableVoice" }, "bus": { "oneOf": [{ "$ref": "#/$defs/track" }, { "type": "null" }] } },
      "allOf": [
        { "if": { "properties": { "scope": { "const": "voice" } } }, "then": { "properties": { "voice": { "$ref": "#/$defs/voice" }, "bus": { "type": "null" } } } },
        { "if": { "properties": { "scope": { "const": "bus" } } }, "then": { "properties": { "voice": { "type": "null" }, "bus": { "$ref": "#/$defs/track" } } } },
        { "if": { "properties": { "scope": { "const": "master" } } }, "then": { "properties": { "voice": { "type": "null" }, "bus": { "type": "null" } } } }
      ]
    },
    "setVolume": {
      "allOf": [{ "$ref": "#/$defs/scopeFields" }, { "type": "object", "additionalProperties": false, "required": ["kind", "scope", "voice", "bus", "volume"], "properties": { "kind": { "const": "setVolume" }, "scope": { "enum": ["voice", "bus", "master"] }, "voice": { "$ref": "#/$defs/nullableVoice" }, "bus": { "oneOf": [{ "$ref": "#/$defs/track" }, { "type": "null" }] }, "volume": { "$ref": "#/$defs/volume" } } }]
    },
    "fade": {
      "allOf": [{ "$ref": "#/$defs/scopeFields" }, { "type": "object", "additionalProperties": false, "required": ["kind", "scope", "voice", "bus", "fromVolume", "targetVolume", "durationTicks"], "properties": { "kind": { "const": "fade" }, "scope": { "enum": ["voice", "bus", "master"] }, "voice": { "$ref": "#/$defs/nullableVoice" }, "bus": { "oneOf": [{ "$ref": "#/$defs/track" }, { "type": "null" }] }, "fromVolume": { "$ref": "#/$defs/volume" }, "targetVolume": { "$ref": "#/$defs/volume" }, "durationTicks": { "$ref": "#/$defs/ticks" } } }, { "not": { "properties": { "scope": { "const": "master" } } } }]
    },
    "setBank": {
      "type": "object", "additionalProperties": false,
      "required": ["kind", "bankKind", "bank"],
      "properties": { "kind": { "const": "setBank" }, "bankKind": { "type": "string", "minLength": 1 }, "bank": { "$ref": "#/$defs/nullableBank" } }
    },
    "event": {
      "oneOf": [{ "$ref": "#/$defs/ready" }, { "$ref": "#/$defs/ended" }, { "$ref": "#/$defs/error" }]
    },
    "ready": {
      "type": "object", "additionalProperties": false,
      "required": ["kind", "voice", "lengthTicks"],
      "properties": { "kind": { "const": "ready" }, "voice": { "$ref": "#/$defs/voice" }, "lengthTicks": { "$ref": "#/$defs/nullableTicks" } }
    },
    "ended": {
      "type": "object", "additionalProperties": false,
      "required": ["kind", "voice", "cue"],
      "properties": { "kind": { "const": "ended" }, "voice": { "$ref": "#/$defs/voice" }, "cue": { "$ref": "#/$defs/voice" } }
    },
    "error": {
      "type": "object", "additionalProperties": false,
      "required": ["kind", "voice", "cue", "code", "detail"],
      "properties": { "kind": { "const": "error" }, "voice": { "$ref": "#/$defs/nullableVoice" }, "cue": { "$ref": "#/$defs/nullableVoice" }, "code": { "$ref": "#/$defs/errorCode" }, "detail": { "type": "string" } }
    },
    "voiceState": { "enum": ["loading", "ready", "playing", "paused", "ended", "stopped", "failed"] }
  },
  "x-voice-state-machine": {
    "terminal": ["ended", "stopped", "failed"],
    "transitions": [
      [null, "load", "loading"],
      ["loading", "ready", "ready"], ["loading", "error", "failed"], ["loading", "stop", "stopped"],
      ["ready", "play", "playing"], ["ready", "stop", "stopped"],
      ["playing", "pause", "paused"], ["playing", "ended", "ended"], ["playing", "stop", "stopped"],
      ["paused", "resume", "playing"], ["paused", "stop", "stopped"],
      ["playing", "seek-end", "ended"], ["paused", "seek-end", "ended"]
    ]
  }
}

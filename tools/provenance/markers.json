{
  "scope": {
    "sources": "docs/guardrails.md section G7 (\"A CI provenance scan over source files\")",
    "extensions": [
      ".ts",
      ".tsx",
      ".mts",
      ".cts",
      ".js",
      ".jsx",
      ".mjs",
      ".cjs",
      ".json",
      ".yml",
      ".yaml",
      ".toml",
      ".html",
      ".css",
      ".c",
      ".cc",
      ".cpp",
      ".cxx",
      ".h",
      ".hh",
      ".hpp",
      ".hxx"
    ],
    "skipRootPaths": [
      "docs",
      "_bmad",
      "_bmad-output",
      "tools/provenance/markers.json"
    ],
    "skipDirectoryNames": [
      "node_modules",
      "dist",
      "build",
      "coverage"
    ],
    "skipFileNames": [
      "LICENSE",
      "THIRD_PARTY_NOTICES",
      "pnpm-lock.yaml"
    ],
    "keepDotDirectories": [
      ".github"
    ]
  },
  "categories": {

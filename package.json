{
  "name": "rpgtoolkit-reawakened",
  "private": true,
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@12.10.1",
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc -b && pnpm -r --if-present run typecheck:tests",
    "test": "tsc -b && node --test \"packages/*/test/*.test.ts\"",
    "lint": "node tools/check-core-deps.mjs && eslint .",
    "graph": "node tools/deps/graph.mjs",
    "graph:write": "node tools/deps/graph.mjs --write",
    "graph:test": "node --test tools/deps/test/graph.test.mjs"
  },
  "devDependencies": {
    "@typescript/native": "npm:typescript@7.0.2",
    "dependency-cruiser": "18.5.0",
    "eslint": "10.12.0",
    "typescript": "npm:@typescript/typescript6@6.0.2",
    "typescript-eslint": "8.71.1"
  }
}
